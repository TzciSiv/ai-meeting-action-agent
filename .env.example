# Shared template for local development and Docker Compose.
# Docker containers use the service DATABASE_URL values in docker-compose.yml.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_SUMMARY_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=120
LANGCHAIN_PGVECTOR_COLLECTION=meeting_transcript_chunks
APP_LOG_LEVEL=INFO
PROMETHEUS_METRICS_ENABLED=true
OTEL_TRACES_ENABLED=true
OTEL_SERVICE_NAME=ai-meeting-action-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
SLA_ANALYSIS_AVERAGE_SECONDS=30
SLA_ANALYSIS_MAX_SECONDS=120
SLA_ERROR_RATE_OBJECTIVE=below 5% in local/demo runs
DATABASE_URL=postgresql+psycopg://meeting_agent:meeting_agent@localhost:5432/meeting_agent
JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_EXPIRE_MINUTES=10080
DEFAULT_USER_ROLE=owner
DEMO_USER_ROLE=admin
FIRST_USER_ADMIN=true
SYNC_DEMO_USER_ROLE=true
PROMPT_REGISTRY_DEFAULT_STATUS=approved
MAX_UPLOAD_BYTES=26214400
MAX_TRANSCRIPT_CHARS=250000
RATE_LIMIT_PER_MINUTE=120
USER_DAILY_AI_COST_LIMIT=0
OPENAI_INPUT_TOKEN_COST_PER_1K=0
OPENAI_OUTPUT_TOKEN_COST_PER_1K=0
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_WORKER_GROUP_ID=meeting-agent-worker
KAFKA_AUTO_OFFSET_RESET=earliest
WORKER_FALLBACK_TO_OUTBOX=true
BACKEND_WORKER_REPLICAS=3
WORKER_HEARTBEAT_INTERVAL_SECONDS=30
WORKER_HEARTBEAT_STALE_AFTER_SECONDS=90
WORKER_QUEUE_RECOVERY_SECONDS=5
WORKER_QUEUE_RECOVERY_INTERVAL_SECONDS=2
WORKER_KAFKA_POLL_TIMEOUT_MS=1000
WORKER_HEARTBEAT_RETAIN_COUNT=10
AIRFLOW__CORE__LOAD_EXAMPLES=false
